# Copy to .env for local development. In production these are Fly secrets.

CROSSREF_MAILTO=jlewis2@olympic.edu

# Mail is sent through Resend, which speaks plain SMTP, so the app code is
# unchanged from any other provider.
#
# SMTP_PASSWORD is a Resend API key (starts re_). It is the only value here
# that is a credential; set it at
#   https://fly.io/apps/eunomias-labors/secrets
# and never put it in this file or in a shell command.
#
# While the domain is unverified, Resend only allows:
#   SMTP_FROM = onboarding@resend.dev
#   recipients = the address the Resend account was registered with
# Verify eunomiaslabors.xyz in the Resend dashboard to lift both limits, then
# change SMTP_FROM to forms@eunomiaslabors.xyz.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=
SMTP_FROM=onboarding@resend.dev
NOTIFY_TO=jlewis2@olympic.edu
